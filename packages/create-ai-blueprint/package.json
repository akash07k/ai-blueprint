{
  "name": "@akash07k/create-ai-blueprint",
  "version": "0.9.2",
  "description": "Install a file-backed, spec-driven AI development workflow into a scaffolded app.",
  "license": "MIT",
  "author": "Akash Kakkar",
  "type": "module",
  "homepage": "https://github.com/akash07k/ai-blueprint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akash07k/ai-blueprint.git",
    "directory": "packages/create-ai-blueprint"
  },
  "bugs": {
    "url": "https://github.com/akash07k/ai-blueprint/issues"
  },
  "keywords": [
    "ai",
    "ai-coding",
    "blueprint",
    "github-copilot",
    "codex",
    "claude",
    "claude-code",
    "agent",
    "context-engineering",
    "spec-driven-development",
    "workflow",
    "scaffold"
  ],
  "bin": {
    "create-ai-blueprint": "dist/bin/create-ai-blueprint.js",
    "blueprint": "dist/bin/blueprint.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/build-plan.test.ts test/current-work.test.ts test/findings.test.ts test/project-metadata.test.ts test/project-root.test.ts test/status.test.ts test/update.test.ts",
    "check:pack": "npm pack --dry-run",
    "prepare-template": "tsx scripts/prepare-template.ts",
    "prepack": "npm run build && npm run prepare-template",
    "postpack": "tsx scripts/clean-template.ts"
  },
  "files": [
    "dist/",
    "template/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
